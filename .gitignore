__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.venv/
.ipynb_checkpoints/

# Historical runners may create outputs next to their archived sources.
# Keep those generated datasets/checkpoints out of Git too.
archive/**/artifacts/

# Generated PTB-XL arrays are multi-gigabyte local artifacts.
preprocessing/artifacts/

# Keep compact experiment evidence in Git. Weights, waveform arrays, and
# reconstruction example images remain local; changing ignores does not download
# server outputs or automatically add/commit existing records.
experiments/artifacts/**
!experiments/artifacts/**/
!experiments/artifacts/**/*.csv
!experiments/artifacts/**/*.json
!experiments/artifacts/**/*.md
!experiments/artifacts/**/*curves*.png
!experiments/artifacts/**/gradient_updates.png
!experiments/artifacts/**/condition_comparison.png

# Scratch caches must stay excluded even when they contain JSON/CSV manifests.
experiments/artifacts/phase1/cache/
